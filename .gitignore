.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/
.env

# Private order files. Folder placeholders stay so the layout is clear.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Forecast and evaluation files include locations, items, and quantities.
# Ignore generated outputs by default. Only the reviewed files below are published.
outputs/*
!outputs/.gitkeep
!outputs/model_comparison.csv
!outputs/ml_model_evaluation.csv
!outputs/xgboost_model_evaluation.csv
!outputs/levis_sku_4_week_forecast.csv
!outputs/levis_category_4_week_forecast.csv
!outputs/souledstore_sku_4_week_forecast.csv
!outputs/souledstore_category_4_week_forecast.csv
